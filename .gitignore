.superpowers/
node_modules/
dist/
*.log
__pycache__/
# 官方素材形象：本地/release 分发，不进仓库（非商业同人使用条款）
assets/pet/*.png
assets/pet/*.webp
# 解包试作产物：纯本地评估，永不入库
assets/_extract/
src/renderer/public/official_pet/
# 解包/逆向工具链（含解密密钥调用）：永不入公开仓库，仅本地使用
scripts/*.py
assets/_extract/_tools/
# 官方解包模型（说怪话 pet03）：本地素材，永不入库
assets/official_pet/

docs/refs/
# 宣传视频/字幕/解说词：自行发布到社交平台，不进仓库
docs/*.mp4
docs/*.srt
docs/解说词-*.txt

# 本机数据（截图等），不入库
data/
release/
build/icon-256.png

# 内嵌 Python（构建时生成，不入库）
python-embed/

# 临时 TTS 依赖（不提交）
.tts/

# GitHub Release 请求体临时文件
release-body.json

# Remotion 宣传视频工程：仅本地生成视频用，不进仓库
promo-video/node_modules/
promo-video/out/
promo-video/.tmp-render/
promo-video/public/audio/
promo-video/public/shots/
# 发布版成片与剪映素材：体积大，自行留存，不进仓库
docs/发布版/
docs/剪映素材/

# 编译产物 out/ 仅在本地忽略（用 .git/info/exclude），不能在 .gitignore 里写 out/
# 否则 electron-builder 会把它排除出安装包，导致打出的 exe 无法启动

# 打包产物（体积大，不进仓库）
release/
release-manual/
release-final/
dist-app/
ab-outside/

# 嵌入 Python 运行环境（902 个文件，体积大）
python-embed/

docs/celebration/
